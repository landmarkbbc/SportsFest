rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global safety net: deny all collections not explicitly matched below.
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    // Light sanity checks: payload is a map and bounded well below Firestore's 1 MiB / key-count limits.
    function isValidMapDoc(data) {
      return data is map && data.size() <= 50;
    }

    match /games/{gameId} {
      allow read, create, update, delete: if isSignedIn();
    }

    match /players/{playerId} {
      allow read, create, update, delete: if isSignedIn();
    }

    match /settings/{settingId} {
      allow read, create, update, delete: if isSignedIn();
    }

    match /brackets/{gameId} {
      allow read, delete: if isSignedIn();
      allow create, update: if isSignedIn() && isValidMapDoc(request.resource.data);
    }

    match /pairs/{gameId} {
      allow read, delete: if isSignedIn();
      allow create, update: if isSignedIn() && isValidMapDoc(request.resource.data);
    }
  }
}
